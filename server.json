  "version": "1.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "crewchat",
      "version": "1.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "stdio"
        }
      ]
    }
  ]
